# Optional Vite env (copy to .env.local — never commit secrets)

# Release label for client error reports (CI sets this to the git SHA)
# VITE_APP_VERSION=local

# Optional error beacon URL. Leave unset for console-only reporting.
# When set, also add the origin to connect-src in index.html CSP and public/_headers.
# VITE_TELEMETRY_URL=https://example.com/collect
